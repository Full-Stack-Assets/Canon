#!/usr/bin/env bash
# Soft hook: warn when high-risk paths change without a local receipt.
set -euo pipefail
HIGH='^(enforcement/|\.githooks/|\.github/workflows/|aoc/PORTFOLIO\.yaml)'
if git diff --cached --name-only | grep -Eq "$HIGH"; then
  CANON_RECEIPTS="$(find evidence/receipts .aoc/receipts -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
  if [[ -z "$CANON_RECEIPTS" ]]; then
    echo "AOC/Canon: high-risk path staged, no evidence/receipts/ or .aoc/receipts/ found." >&2
    if [[ "${AOC_HOOKS_HARD:-0}" == "1" ]]; then
      exit 1
    fi
    echo "AOC/Canon: soft warning only." >&2
  fi
fi
exit 0
