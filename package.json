{
  "name": "@full-stack-assets/canon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "mcp:stdio": "CANON_MCP_TRANSPORT=stdio node mcp/server.mjs",
    "snapshot": "node scripts/build-mcp-snapshot.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "node --test",
    "static": "node --check preflight/run_preflight.mjs && node --check preflight/capability_router.mjs && node --check .github/actions/revenue-ready-release/validate.mjs",
    "verify": "npm test && npm run static && node preflight/run_preflight.mjs \"Verify the read-only Canon MCP server implementation and evidence receipt.\"",
    "revenue-gate": "node .github/actions/revenue-ready-release/validate.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.102.0"
  }
}

