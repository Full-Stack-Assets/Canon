{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon.aoc/enforcement/PREFLIGHT-RECEIPT.schema.json",
  "title": "PreflightReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "schema", "id", "timestamp", "input_digest", "input_summary",
    "routed_to", "checks", "decision", "fail_closed", "work_permitted",
    "status_marker", "notes", "enforcement_version"
  ],
  "properties": {
    "version": { "const": "1.0.0" },
    "schema": { "const": "canon.preflight.receipt" },
    "id": { "type": "string", "minLength": 8 },
    "timestamp": { "type": "string" },
    "input_digest": { "type": "string" },
    "input_summary": { "type": "string" },
    "routed_to": {
      "type": "object",
      "required": ["authority", "company", "division_id", "division_name", "canon_refs", "roles"],
      "properties": {
        "authority": { "const": "HUMAN_AUTHORITY" },
        "company": { "const": "AGENT_OPERATING_COMPANY" },
        "division_id": { "type": "string" },
        "division_name": { "type": "string" },
        "canon_refs": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "result", "detail"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "result": { "enum": ["pass", "fail", "warn"] },
          "detail": { "type": "string" }
        }
      }
    },
    "decision": { "enum": ["PASS", "ESCALATE", "FAIL"] },
    "fail_closed": { "type": "boolean" },
    "work_permitted": { "type": "boolean" },
    "status_marker": {
      "type": "string",
      "pattern": "^\\[AOC/Canon • Preflight (PASS|ESCALATE|FAIL)\\]$"
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "enforcement_version": { "type": "string" }
  }
}
